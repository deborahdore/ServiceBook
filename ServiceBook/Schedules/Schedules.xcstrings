    "Also after washing the bike or riding in the rain. Use chain lube for O/X-ring chains." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche dopo aver lavato la moto o guidato sotto la pioggia. Usa un lubrificante per catene O/X-ring."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aussi après avoir lavé la moto ou roulé sous la pluie. Utilisez un lubrifiant pour chaînes à joints O/X."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También después de lavar la moto o circular con lluvia. Usa lubricante para cadenas con retenes O/X."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também depois de lavar a mota ou andar à chuva. Use lubrificante para correntes com o-rings/x-rings."
          }
        }
      }
    },
    "Also check washer fluid. Pressures are on the label in the driver's door frame." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla anche il liquido lavavetri. Le pressioni sono sull'etichetta nel montante della portiera del conducente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez aussi le lave-glace. Les pressions figurent sur l’étiquette dans l’encadrement de la portière conducteur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba también el líquido limpiaparabrisas. Las presiones están en la etiqueta del marco de la puerta del conductor."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique também o líquido do lava-vidros. As pressões estão na etiqueta no aro da porta do condutor."
          }
        }
      }
    },
    "Auxiliary drive belt" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinghia dei servizi"
          }
        },
        "fr" : {
          "stringUnit" : {
