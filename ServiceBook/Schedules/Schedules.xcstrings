    "Depends on your country. France & Italy: first at 4 years, then every 2 years. UK MOT: first at 3 years, then yearly. Edit this item to match your country." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipende dal paese. Francia e Italia: la prima a 4 anni, poi ogni 2 anni. Regno Unito (MOT): la prima a 3 anni, poi ogni anno. Modifica questa voce in base al tuo paese."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépend du pays. France et Italie : premier à 4 ans, puis tous les 2 ans. Royaume-Uni (MOT) : premier à 3 ans, puis chaque année. Modifiez cet élément selon votre pays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depende del país. Francia e Italia: la primera a los 4 años, después cada 2 años. Reino Unido (MOT): la primera a los 3 años, después cada año. Edita este elemento según tu país."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depende do país. França e Itália: a primeira aos 4 anos, depois a cada 2 anos. Reino Unido (MOT): a primeira aos 3 anos, depois todos os anos. Edite este item de acordo com o seu país."
          }
        }
      }
    },
    "Depends on your country. France (2-wheelers): first at 5 years, then every 3 years. Italy: first at 4 years, then every 2. UK MOT: first at 3 years, then yearly. Edit this item to match your country." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipende dal paese. Francia (due ruote): la prima a 5 anni, poi ogni 3 anni. Italia: la prima a 4 anni, poi ogni 2. Regno Unito (MOT): la prima a 3 anni, poi ogni anno. Modifica questa voce in base al tuo paese."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépend du pays. France (deux-roues) : premier à 5 ans, puis tous les 3 ans. Italie : premier à 4 ans, puis tous les 2 ans. Royaume-Uni (MOT) : premier à 3 ans, puis chaque année. Modifiez cet élément selon votre pays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depende del país. Francia (dos ruedas): la primera a los 5 años, después cada 3 años. Italia: la primera a los 4 años, después cada 2. Reino Unido (MOT): la primera a los 3 años, después cada año. Edita este elemento según tu país."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depende do país. França (duas rodas): a primeira aos 5 anos, depois a cada 3 anos. Itália: a primeira aos 4 anos, depois a cada 2. Reino Unido (MOT): a primeira aos 3 anos, depois todos os anos. Edite este item de acordo com o seu país."
          }
        }
      }
    },
