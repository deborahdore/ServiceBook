    "Kawasaki also lists the initial change at 1,000 km. Check the level in the sight glass before every ride (bike upright, engine off for a few minutes)." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kawasaki indica anche il primo cambio a 1.000 km. Controlla il livello nell'oblò prima di ogni uscita (moto dritta, motore spento da qualche minuto)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kawasaki indique aussi la première vidange à 1 000 km. Vérifiez le niveau au hublot avant chaque sortie (moto droite, moteur arrêté depuis quelques minutes)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kawasaki también indica el primer cambio a los 1.000 km. Comprueba el nivel en la mirilla antes de cada salida (moto recta, motor parado unos minutos)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Kawasaki também indica a primeira mudança aos 1000 km. Verifique o nível no visor antes de cada saída (mota direita, motor desligado há alguns minutos)."
          }
        }
      }
    },
    "Legal minimum in the EU: 1.6 mm. Record tread depth for each tyre." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
