        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mínimo legal en la UE: 1,6 mm. Anota la profundidad del dibujo de cada neumático."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mínimo legal na UE: 1,6 mm. Registe a profundidade do piso de cada pneu."
          }
