    "Do a regular 20+ minute motorway drive so the DPF can regenerate, especially if you mostly do short trips." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai regolarmente un tragitto in autostrada di almeno 20 minuti per permettere la rigenerazione del DPF, soprattutto se fai per lo più tragitti brevi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites régulièrement plus de 20 minutes d’autoroute pour que le FAP se régénère, surtout si vous faites surtout des trajets courts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz con regularidad un trayecto de más de 20 minutos por autopista para que el FAP se regenere, sobre todo si haces principalmente trayectos cortos."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça regularmente um percurso de mais de 20 minutos em autoestrada para o FAP regenerar, sobretudo se faz principalmente trajetos curtos."
          }
        }
      }
    },
