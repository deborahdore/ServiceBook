    "Fiesta Mk8 launched in mid-2017: a 1.5 TDCi registered from late 2017 is almost always a Mk8. Intervals are 'whichever comes first'." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Fiesta Mk8 è uscita a metà 2017: una 1.5 TDCi immatricolata da fine 2017 è quasi sempre una Mk8. Gli intervalli valgono «a seconda di quale scade prima»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Fiesta Mk8 est sortie mi-2017 : une 1.5 TDCi immatriculée à partir de fin 2017 est presque toujours une Mk8. Les intervalles s’appliquent « au premier des deux termes atteint »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Fiesta Mk8 salió a mediados de 2017: un 1.5 TDCi matriculado desde finales de 2017 es casi siempre un Mk8. Los intervalos son «lo que ocurra primero»."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiesta Mk8 foi lançado em meados de 2017: um 1.5 TDCi matriculado a partir do final de 2017 é quase sempre um Mk8. Os intervalos são «o que ocorrer primeiro»."
          }
        }
      }
    },
