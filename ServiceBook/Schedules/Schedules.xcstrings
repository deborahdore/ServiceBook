        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correia de acessórios"
          }
        }
      }
    },
    "Based on Ford's official 2013 Fiesta 1.0 EcoBoost service sheets. Intervals are 'whichever comes first'." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basato sulle schede di manutenzione ufficiali Ford della Fiesta 1.0 EcoBoost del 2013. Gli intervalli valgono «a seconda di quale scade prima»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’après les fiches d’entretien officielles Ford de la Fiesta 1.0 EcoBoost de 2013. Les intervalles s’appliquent « au premier des deux termes atteint »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basado en las hojas de mantenimiento oficiales de Ford del Fiesta 1.0 EcoBoost de 2013. Los intervalos son «lo que ocurra primero»."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com base nas fichas de manutenção oficiais da Ford para o Fiesta 1.0 EcoBoost de 2013. Os intervalos são «o que ocorrer primeiro»."
          }
        }
      }
    },
