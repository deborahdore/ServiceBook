    "6.2 L incl. filter · dipstick MIN→MAX = 1.75 L (2021 manual, 1.5 Duratorq-TDCi — check your handbook for earlier builds)" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6,2 L con filtro · astina MIN→MAX = 1,75 L (manuale 2021, 1.5 Duratorq-TDCi — per gli esemplari precedenti controlla il tuo libretto)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6,2 L avec filtre · jauge MIN→MAX = 1,75 L (manuel 2021, 1.5 Duratorq-TDCi — vérifiez votre manuel pour les modèles plus anciens)"
