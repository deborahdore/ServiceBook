    "After adjusting, align both adjusters and tighten the rear axle nut to 98 N·m." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo la regolazione, allinea entrambi i tendicatena e serra il dado del perno ruota posteriore a 98 N·m."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après réglage, alignez les deux tendeurs et serrez l’écrou d’axe de roue arrière à 98 N·m."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras ajustarla, alinea ambos tensores y aprieta la tuerca del eje trasero a 98 N·m."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de ajustar, alinhe os dois esticadores e aperte a porca do eixo traseiro a 98 N·m."
          }
        }
      }
    },
