          }
        }
      }
    },
    "Tip: the more precise the model, year and engine, the better the result. Edit the vehicle first if needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: cuanto más precisos sean el modelo, el año y el motor, mejor será el resultado. Edita antes el vehículo si hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : plus le modèle, l’année et le moteur sont précis, meilleur est le résultat. Modifiez d’abord le véhicule si besoin."
          }
        },
        "it" : {
