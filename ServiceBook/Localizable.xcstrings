    "You can keep the app open while Claude reads — nothing is added until you review the result." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes dejar la app abierta mientras Claude lee: no se añade nada hasta que revises el resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez garder l’app ouverte pendant que Claude lit — rien n’est ajouté avant que vous ayez vérifié le résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi tenere l'app aperta mentre Claude legge: non viene aggiunto nulla finché non rivedi il risultato."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode manter a app aberta enquanto o Claude lê — nada é adicionado até rever o resultado."
          }
        }
      }
    },
