    "Items you have never logged are counted from new (0 km / first registration). Turn on “History unknown” for a used vehicle without service records." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos que nunca has registrado se cuentan desde nuevo (0 km / primera matriculación). Activa «Historial desconocido» para un vehículo usado sin libro de mantenimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments jamais notés sont comptés depuis le neuf (0 km / première immatriculation). Activez « Historique inconnu » pour un véhicule d’occasion sans carnet d’entretien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci mai registrate sono contate dal nuovo (0 km / prima immatricolazione). Attiva “Storico sconosciuto” per un veicolo usato senza libretto dei tagliandi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens que nunca registou são contados desde novo (0 km / primeira matrícula). Ative «Histórico desconhecido» para um veículo usado sem registos de manutenção."
          }
        }
      }
    },
    "Items you have never logged will be counted from today's mileage, instead of showing as overdue." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos que nunca has registrado se contarán desde el kilometraje de hoy, en lugar de aparecer como vencidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments jamais notés seront comptés à partir du kilométrage actuel, au lieu d’apparaître en retard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci mai registrate verranno contate dal chilometraggio di oggi, invece di risultare scadute."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens que nunca registou serão contados a partir da quilometragem de hoje, em vez de aparecerem em atraso."
          }
        }
      }
    },
