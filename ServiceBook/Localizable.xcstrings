    "Stored in this device's Keychain only (not synced to iCloud) and sent only to api.anthropic.com. You pay Anthropic directly for what you use; set a monthly limit in the console if you like." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda solo en el llavero de este dispositivo (no se sincroniza con iCloud) y solo se envía a api.anthropic.com. Pagas directamente a Anthropic por lo que usas; si quieres, fija un límite mensual en la consola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockée uniquement dans le trousseau de cet appareil (non synchronisée avec iCloud) et envoyée uniquement à api.anthropic.com. Vous payez directement Anthropic pour ce que vous utilisez ; fixez une limite mensuelle dans la console si vous le souhaitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
