    "A notification one week before and on the day a time-based item is due. Mileage-based items are shown in the app — keep your mileage up to date." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación una semana antes y el día en que vence un elemento por tiempo. Los elementos por kilometraje se muestran en la app: mantén tu kilometraje al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification une semaine avant et le jour où un élément basé sur le temps arrive à échéance. Les éléments basés sur le kilométrage sont affichés dans l’app — tenez votre kilométrage à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notifica una settimana prima e il giorno in cui scade una voce basata sul tempo. Le voci basate sui km sono mostrate nell'app: tieni aggiornato il chilometraggio."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação uma semana antes e no dia em que um item por tempo vence. Os itens por quilometragem são mostrados na app — mantenha a quilometragem atualizada."
          }
        }
      }
    },
