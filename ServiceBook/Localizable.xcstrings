    "Your vehicle isn't listed? Use “Find the manual online (AI)” or “Import a manual PDF (AI)”. Contributions of new schedules are welcome on GitHub." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tu vehículo no aparece? Usa «Buscar el manual en línea (IA)» o «Importar un manual PDF (IA)». Las contribuciones de nuevos planes son bienvenidas en GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre véhicule n’est pas dans la liste ? Utilisez « Trouver le manuel en ligne (IA) » ou « Importer un manuel PDF (IA) ». Les contributions de nouveaux plans sont bienvenues sur GitHub."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo veicolo non c'è? Usa “Trova il manuale online (IA)” o “Importa un manuale PDF (IA)”. I contributi con nuovi piani sono benvenuti su GitHub."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu veículo não está na lista? Use «Procurar o manual online (IA)» ou «Importar um manual PDF (IA)». Contribuições com novos planos são bem-vindas no GitHub."
          }
        }
      }
