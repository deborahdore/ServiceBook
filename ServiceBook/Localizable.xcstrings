    "Schedules are a guide. Always follow your owner's manual and your mechanic's advice — the authors accept no responsibility for missed or incorrect maintenance." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planes son orientativos. Sigue siempre el manual del propietario y los consejos de tu mecánico: los autores no se hacen responsables de mantenimientos omitidos o incorrectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans sont indicatifs. Suivez toujours le manuel du propriétaire et les conseils de votre mécanicien — les auteurs déclinent toute responsabilité en cas d’entretien oublié ou incorrect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I piani sono indicativi. Segui sempre il libretto d'uso e i consigli del tuo meccanico: gli autori non si assumono alcuna responsabilità per manutenzioni mancate o errate."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os planos são indicativos. Siga sempre o manual do proprietário e os conselhos do seu mecânico — os autores não se responsabilizam por manutenções em falta ou incorretas."
          }
        }
      }
    },
